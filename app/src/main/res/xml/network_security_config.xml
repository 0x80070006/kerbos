<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS uniquement. Les CA installées par l'utilisateur sont acceptées
         (utile pour un Nextcloud auto-hébergé avec sa propre autorité). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
